        "--source-campaign-id", "x21-architecture-capacity-v1",
        "--expected-manifest", "${REPO_ROOT}/experiments/manifests/x21_architecture_capacity_v1.json",
        "--job-id", "resource-preflight-k24-d14",
        "--source-summary", "${BASE_CAPACITY_RUN_ROOT}/resource_preflight/k24_d14/summary.json",
        "--site-count", "24",
        "--bond-dimension", "14",
        "--parameter-count", "1050280",
        "--positive-floor", "1e-14",
        "--train-pool", "${TRAIN_POOL}",
        "--train-pool-sha256", "050092ddc3f0847cde4b730ddd33c4e7faa6cbaffbfdafd147b171a5f191cf94",
        "--selection-pool", "${SELECTION_POOL}",
        "--selection-pool-sha256", "d39779ad4bc0dc7bd4381486b198124a563d9a798bfe425a60775e87a1ef7ee9",
        "--allocated-max-bytes", "21474836480",
        "--reserved-max-bytes", "23085449216",
        "--out", "${CERTIFICATES}/d14_prerequisite.json"
      ],
      "expected_outputs": ["${CERTIFICATES}/d14_prerequisite.json"],
      "json_gates": [
        {"path": "${CERTIFICATES}/d14_prerequisite.json", "field": "status", "equals": "passed"},
        {"path": "${CERTIFICATES}/d14_prerequisite.json", "field": "exit_code", "equals": 0},
        {"path": "${CERTIFICATES}/d14_prerequisite.json", "field": "bond_dimension", "equals": 14},
        {"path": "${CERTIFICATES}/d14_prerequisite.json", "field": "all_summary_numbers_finite", "equals": true},
        {"path": "${CERTIFICATES}/d14_prerequisite.json", "field": "strictly_positive_validation_metric", "equals": true}
      ],
      "retry": {"max_attempts": 1},
      "scientific": {"role": "hash-bound cross-campaign D14 resource prerequisite", "accuracy_job": false}
    },
    {
      "id": "prepare-q121-k4",
      "phase": "prepare",
      "needs": ["certify-d14-prerequisite"],
      "command": [
        "${PYTHON}", "scripts/complete_positive_tensor_network_dictionary.py",
        "--model", "${COMMON_K4}",
        "--out", "${PREPARED}/q121_k4_completed.pt",
        "--summary", "${PREPARED}/q121_k4_completed_summary.json"
      ],
      "expected_outputs": ["${PREPARED}/q121_k4_completed.pt", "${PREPARED}/q121_k4_completed_summary.json"]
    },
    {
      "id": "prepare-floor-1e14",
      "phase": "prepare",
      "needs": ["prepare-q121-k4"],
      "command": [
        "${PYTHON}", "scripts/set_positive_tensor_network_floor.py",
        "--model", "${PREPARED}/q121_k4_completed.pt",
        "--positive-floor", "1e-14",
        "--out", "${PREPARED}/q121_k4_floor1e14_c128.pt",
        "--summary", "${PREPARED}/q121_k4_floor1e14_c128_summary.json"
      ],
      "expected_outputs": ["${PREPARED}/q121_k4_floor1e14_c128.pt", "${PREPARED}/q121_k4_floor1e14_c128_summary.json"],
      "json_gates": [
        {"path": "${PREPARED}/q121_k4_floor1e14_c128_summary.json", "field": "strictly_positive", "equals": true}
      ]
    },
    {
      "id": "prepare-complex64-origin",
      "phase": "prepare",
      "needs": ["prepare-floor-1e14"],
      "command": [
        "${PYTHON}", "scripts/cast_positive_tensor_network_precision.py",
        "--model", "${PREPARED}/q121_k4_floor1e14_c128.pt",
        "--precision", "complex64",
        "--out", "${PREPARED}/q121_k4_floor1e14_c64.pt",
        "--summary", "${PREPARED}/q121_k4_floor1e14_c64_cast.json"
      ],
      "expected_outputs": ["${PREPARED}/q121_k4_floor1e14_c64.pt", "${PREPARED}/q121_k4_floor1e14_c64_cast.json"],
      "json_gates": [
        {"path": "${PREPARED}/q121_k4_floor1e14_c64_cast.json", "field": "source_precision", "equals": "complex128"},
        {"path": "${PREPARED}/q121_k4_floor1e14_c64_cast.json", "field": "target_precision", "equals": "complex64"},
        {"path": "${PREPARED}/q121_k4_floor1e14_c64_cast.json", "field": "optimizer_updates", "equals": 0}
      ]
    },
    {
      "id": "initial-sites-k24",
      "phase": "initialize-d16",
      "needs": ["prepare-complex64-origin"],
      "command": [
        "${PYTHON}", "scripts/resize_positive_tensor_network_sites.py",
        "--model", "${PREPARED}/q121_k4_floor1e14_c64.pt",
        "--target-site-count", "24",
        "--transfer-rule", "repeat",
        "--bridge-one-sided-activation-scale", "0.03",
        "--bridge-noise-seed", "8630001",
        "--out", "${INITIAL}/k24/sites.pt",
        "--summary", "${INITIAL}/k24/sites_summary.json"
      ],
      "expected_outputs": ["${INITIAL}/k24/sites.pt", "${INITIAL}/k24/sites_summary.json"]
    },
    {
      "id": "initial-bond-k24-d16",
      "phase": "initialize-d16",
      "needs": ["initial-sites-k24"],
      "command": [
        "${PYTHON}", "scripts/expand_positive_tensor_network_bond.py",
        "--model", "${INITIAL}/k24/sites.pt",
        "--bond-dimension", "16",
        "--initialization-noise", "0",
        "--one-sided-activation-scale", "0.03",
        "--seed", "8640001",
        "--precision", "preserve",
        "--out", "${INITIAL}/k24_d16/raw/model.pt",
        "--summary", "${INITIAL}/k24_d16/raw/summary.json"
