        "--adapter", "p5p1_type21_k3_1223",
        "--model-seed", "20260802",
        "--sampling-cluster-size", "6",
        "--source-artifact", "${SOURCE}",
        "--site-count", "24",
        "--initial-model", "${INITIAL}/k24_d16/canonical/model.pt",
        "--bond-dimension", "16",
        "--kappa-source", "initial_model",
        "--positive-floor", "1e-14",
        "--initialization-noise", "0",
        "--train-points", "196608",
        "--train-seed", "86201",
        "--train-common-pool", "${TRAIN_POOL}",
        "--validation-points", "24576",
        "--validation-seed", "86202",
        "--validation-common-pool", "${SELECTION_POOL}",
        "--workers", "1",
        "--epochs", "1",
        "--batch-size", "1024",
        "--learning-rate", "2e-4",
        "--gradient-clip-norm", "2",
        "--potential-loss-weight", "0",
