      "expected_outputs": ["${INITIAL}/k24_d16/raw/model.pt", "${INITIAL}/k24_d16/raw/summary.json"],
      "json_gates": [
        {"path": "${INITIAL}/k24_d16/raw/summary.json", "field": "precision", "equals": "complex64"},
        {"path": "${INITIAL}/k24_d16/raw/summary.json", "field": "function_preserving_by_construction", "equals": true},
        {"path": "${INITIAL}/k24_d16/raw/summary.json", "field": "new_channels_have_first_order_activation", "equals": true}
      ]
    },
    {
      "id": "initial-canonical-k24-d16",
      "phase": "initialize-d16",
      "needs": ["initial-bond-k24-d16"],
