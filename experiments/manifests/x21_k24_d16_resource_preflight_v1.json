        {"path": "${CERTIFICATES}/d16_resource_preflight.json", "field": "runtime_seconds", "gt": 0}
      ],
      "retry": {"max_attempts": 1},
      "scientific": {"role": "terminal resource-only certificate", "accuracy_job": false},
      "result": {
        "path": "${CERTIFICATES}/d16_resource_preflight.json",
        "fields": {
          "exit_code": "exit_code",
          "maximum_allocated_bytes": "maximum_allocated_bytes",
