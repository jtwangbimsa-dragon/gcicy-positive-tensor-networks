  },
  "source_guard": {
    "release_base_commit": "9f95071647aaf89bd520effeb322b16345d63157",
    "forbidden_branches": ["main", "master"],
    "required_branch_prefix": "exp/",
    "require_clean": true
  },
  "environment": {
    "python": "3.12 recommended",
    "torch": "2.7.1",
    "cuda_required": true,
    "training_precision": "complex64",
    "reference_gpu": "RTX 4090 24 GiB",
    "scope": "resource preflight only; no D16 accuracy claim"
  },
  "scientific_policy": {
    "geometry": "X21 type-(2,1) P5 x P1 seed 20260802",
    "target": {
      "k": 24,
      "D": 16,
      "physical_dictionary_rank": 121,
      "trainable_real_parameter_count": 1370688,
      "precision": "complex64",
      "batch_size": 1024,
      "epochs": 1
    },
    "resource_limits": {
      "maximum_allocated_bytes": 24159191040,
      "maximum_allocated_gib": 22.5,
      "maximum_reserved_bytes": 25232932864,
      "maximum_reserved_gib": 23.5
    },
    "prerequisite": "The x21-architecture-capacity-v1 resource-preflight-k24-d14 job must have a hash-valid succeeded state, zero exit code, all gates passed, and its original 20/21.5 GiB limits satisfied.",
    "scope_boundary": "A passing D16 resource certificate establishes feasibility only. D16 accuracy training remains prohibited until the separate base promotion decision is true and a new accuracy manifest is hash-frozen.",
    "accuracy_jobs": 0
  },
  "defaults": {
    "working_directory": "${REPO_ROOT}",
    "environment": {
      "PYTHONUNBUFFERED": "1",
      "OMP_NUM_THREADS": "1",
      "MKL_NUM_THREADS": "1",
      "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True"
    },
    "retry": {
      "max_attempts": 3,
      "signals": [4, 5, 11],
      "log_patterns": [],
      "backoff_seconds": 60
    }
  },
  "jobs": [
    {
      "id": "certify-d14-prerequisite",
      "phase": "d14-prerequisite",
      "command": [
        "${PYTHON}", "scripts/certify_x21_resource_preflight.py",
