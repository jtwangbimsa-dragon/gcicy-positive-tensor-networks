        {"path": "${INITIAL}/k24_d16/canonical/equivalence.json", "field": "success", "equals": true}
      ],
      "scientific": {"role": "epoch-zero function/metric equivalence only; not an accuracy endpoint", "accuracy_job": false}
    },
