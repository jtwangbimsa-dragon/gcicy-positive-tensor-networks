        {"path": "${INITIAL}/k24_d16/canonical/summary.json", "field": "bond_dimension", "equals": 16},
        {"path": "${INITIAL}/k24_d16/canonical/summary.json", "field": "center", "equals": 12},
        {"path": "${INITIAL}/k24_d16/canonical/summary.json", "field": "trainable_real_parameter_count", "equals": 1370688}
      ]
    },
    {
      "id": "initial-equivalence-k24-d16",
      "phase": "initialize-d16",
      "needs": ["initial-canonical-k24-d16"],
      "resources": {"gpu": true},
      "command": [
        "${PYTHON}", "scripts/audit_positive_tensor_network_equivalence.py",
        "--adapter", "p5p1_type21_k3_1223",
        "--model-a", "${PREPARED}/q121_k4_floor1e14_c64.pt",
        "--model-b", "${INITIAL}/k24_d16/canonical/model.pt",
        "--source-artifact", "${SOURCE}",
        "--model-seed", "20260802",
        "--sampling-cluster-size", "6",
        "--seed", "8650001",
        "--points", "8190",
        "--workers", "1",
        "--chunk-size", "546",
        "--absolute-tolerance", "1e-5",
        "--relative-metric-tolerance", "1e-4",
        "--allow-different-site-counts",
        "--device", "cuda",
        "--out", "${INITIAL}/k24_d16/canonical/equivalence.json"
