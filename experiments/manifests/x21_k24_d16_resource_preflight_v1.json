      "expected_outputs": ["${PREFLIGHT}/checkpoint.pt", "${PREFLIGHT}/model.pt", "${PREFLIGHT}/summary.json"],
      "json_gates": [
        {"path": "${PREFLIGHT}/summary.json", "field": "termination_reason", "equals": "completed_requested_epochs"},
        {"path": "${PREFLIGHT}/summary.json", "field": "site_count", "equals": 24},
        {"path": "${PREFLIGHT}/summary.json", "field": "bond_dimension", "equals": 16},
        {"path": "${PREFLIGHT}/summary.json", "field": "precision", "equals": "complex64"},
        {"path": "${PREFLIGHT}/summary.json", "field": "physical_dictionary_rank", "equals": 121},
        {"path": "${PREFLIGHT}/summary.json", "field": "trainable_physical_dictionary", "equals": false},
        {"path": "${PREFLIGHT}/summary.json", "field": "physical_dictionary_gauge", "equals": "fixed"},
        {"path": "${PREFLIGHT}/summary.json", "field": "trainable_real_parameter_count", "equals": 1370688},
        {"path": "${PREFLIGHT}/summary.json", "field": "positive_floor", "equals": 1e-14},
        {"path": "${PREFLIGHT}/summary.json", "field": "train.common_pool", "equals": "${TRAIN_POOL}"},
        {"path": "${PREFLIGHT}/summary.json", "field": "train.common_pool_sha256", "equals": "050092ddc3f0847cde4b730ddd33c4e7faa6cbaffbfdafd147b171a5f191cf94"},
        {"path": "${PREFLIGHT}/summary.json", "field": "validation.common_pool", "equals": "${SELECTION_POOL}"},
        {"path": "${PREFLIGHT}/summary.json", "field": "validation.common_pool_sha256", "equals": "d39779ad4bc0dc7bd4381486b198124a563d9a798bfe425a60775e87a1ef7ee9"},
        {"path": "${PREFLIGHT}/summary.json", "field": "best_validation.minimum_metric_eigenvalue", "gt": 0},
        {"path": "${PREFLIGHT}/summary.json", "field": "runtime_seconds", "gt": 0},
        {"path": "${PREFLIGHT}/summary.json", "field": "device_memory.maximum_allocated_bytes", "gt": 0},
        {"path": "${PREFLIGHT}/summary.json", "field": "device_memory.maximum_allocated_bytes", "le": 24159191040},
        {"path": "${PREFLIGHT}/summary.json", "field": "device_memory.maximum_reserved_bytes", "le": 25232932864}
      ],
      "resume": {"checkpoint": "${PREFLIGHT}/checkpoint.pt", "flag": "--resume-checkpoint"},
      "scientific": {
        "role": "full-pool one-epoch k24,D16 forward/backward/Adam/validation/checkpoint resource preflight",
        "accuracy_job": false,
        "batch_fallback": "forbidden; an OOM is a failed resource preflight"
      }
    },
    {
      "id": "certify-d16-resource-preflight",
      "phase": "resource-certification",
      "needs": ["resource-preflight-k24-d16"],
      "command": [
        "${PYTHON}", "scripts/certify_x21_resource_preflight.py",
        "--source-run-root", "${RUN_ROOT}",
        "--source-campaign-id", "x21-k24-d16-resource-preflight-v1",
        "--expected-manifest", "${REPO_ROOT}/experiments/manifests/x21_k24_d16_resource_preflight_v1.json",
        "--job-id", "resource-preflight-k24-d16",
        "--source-summary", "${PREFLIGHT}/summary.json",
        "--site-count", "24",
        "--bond-dimension", "16",
        "--parameter-count", "1370688",
        "--positive-floor", "1e-14",
        "--train-pool", "${TRAIN_POOL}",
        "--train-pool-sha256", "050092ddc3f0847cde4b730ddd33c4e7faa6cbaffbfdafd147b171a5f191cf94",
        "--selection-pool", "${SELECTION_POOL}",
        "--selection-pool-sha256", "d39779ad4bc0dc7bd4381486b198124a563d9a798bfe425a60775e87a1ef7ee9",
        "--allocated-max-bytes", "24159191040",
        "--reserved-max-bytes", "25232932864",
        "--out", "${CERTIFICATES}/d16_resource_preflight.json"
      ],
      "expected_outputs": ["${CERTIFICATES}/d16_resource_preflight.json"],
      "json_gates": [
        {"path": "${CERTIFICATES}/d16_resource_preflight.json", "field": "status", "equals": "passed"},
        {"path": "${CERTIFICATES}/d16_resource_preflight.json", "field": "exit_code", "equals": 0},
        {"path": "${CERTIFICATES}/d16_resource_preflight.json", "field": "site_count", "equals": 24},
        {"path": "${CERTIFICATES}/d16_resource_preflight.json", "field": "bond_dimension", "equals": 16},
        {"path": "${CERTIFICATES}/d16_resource_preflight.json", "field": "trainable_real_parameter_count", "equals": 1370688},
        {"path": "${CERTIFICATES}/d16_resource_preflight.json", "field": "all_summary_numbers_finite", "equals": true},
        {"path": "${CERTIFICATES}/d16_resource_preflight.json", "field": "strictly_positive_validation_metric", "equals": true},
        {"path": "${CERTIFICATES}/d16_resource_preflight.json", "field": "maximum_allocated_bytes", "le": 24159191040},
