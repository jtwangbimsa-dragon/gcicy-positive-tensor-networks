    }
  ],
  "forbidden_inputs": {
    "policy": "No historical blind, holdout, or development-confirmation data may enter this resource-only campaign.",
    "paths": [
      "${FROZEN_ROOT}/outputs/pipeline/type21_q121_d12_final_blind_20260729",
      "${FROZEN_ROOT}/outputs/pipeline/type21_d8_continuation_capacity_control_20260730/X21_capacity_holdout_seed86206_n98304.npz",
      "${FROZEN_ROOT}/outputs/pipeline/type21_d8_continuation_capacity_control_20260730/X21_capacity_holdout_seed86207_n98304.npz",
      "${FROZEN_ROOT}/outputs/pipeline/gcicy_tn_common_pools_20260728/X21_confirmation_seed86203_n49152.npz",
